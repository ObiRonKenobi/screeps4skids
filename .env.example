# Copy to .env on the server. Do not commit .env.

# Word you give out in person. Checked only by the companion.
SHARED_CODE=

# Steam Web API key. The stock Screeps process will not listen without it.
# It is not a player login. https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Operator account. Created on first boot if it does not exist.
SCREEPS_OWNER_USERNAME=
SCREEPS_OWNER_PASSWORD=

# On inferno this must be the internal disk, not the USB drive.
# SCREEPS_DATA_DIR=/var/lib/screeps

# Optional. Leave unset and the companion uses the owner's room.
# ROOM=W5N5

# Set to 0 to leave an empty main module on first boot.
# SEED_STARTER=1
